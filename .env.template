# NVIDIA API base
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- API Keys (one per role) ---
# Get keys from: https://integrate.api.nvidia.com
# Key 1: Proof Generator
NVIDIA_API_KEY_GENERATOR=nvapi-your-key-1-here

# Key 2: Final Answer Judge
NVIDIA_API_KEY_JUDGE_FINAL=nvapi-your-key-2-here

# Key 3: Toy Case Judge + Numerical Approximation Judge
NVIDIA_API_KEY_JUDGE_TOYCASE=nvapi-your-key-3-here

# Key 4: Logical Gap Judge (uses Lean 4 tool)
NVIDIA_API_KEY_JUDGE_LOGICAL=nvapi-your-key-4-here

# Key 5: Numerical Computation Judge + GEPA Optimizer
NVIDIA_API_KEY_JUDGE_NUMCOMP=nvapi-your-key-5-here

# --- Models ---
# Proof generator — thinking ENABLED (hardest task: generating rigorous proofs)
GENERATION_MODEL=openai/gpt-oss-120b
GENERATION_THINKING=true

# Final Answer Judge — thinking enabled (careful equivalence reasoning)
JUDGE_FINAL_MODEL=nvidia/nemotron-3-super-120b-a12b
JUDGE_FINAL_THINKING=true

# Toy Case + Numerical Approximation Judge
JUDGE_TOYCASE_MODEL=nvidia/nemotron-3-super-120b-a12b
JUDGE_TOYCASE_THINKING=true

# Logical Gap Judge — thinking enabled (hardest judge, uses Lean too)
JUDGE_LOGICAL_MODEL=openai/gpt-oss-120b
JUDGE_LOGICAL_THINKING=true

# Numerical Computation Judge
JUDGE_NUMCOMP_MODEL=nvidia/nemotron-3-super-120b-a12b
JUDGE_NUMCOMP_THINKING=true

# GEPA Optimizer — fast candidate evaluation
GEPA_MODEL=qwen/qwen3-next-80b-a3b-instruct
GEPA_THINKING=false

# --- Generation settings ---
GENERATION_TEMPERATURE=1.0
GENERATION_MAX_TOKENS=16384
JUDGE_MAX_TOKENS=4096
TOP_P=0.95

# --- GEPA / MIPROv2 settings ---
GEPA_NUM_CANDIDATES=5
GEPA_NUM_ITERATIONS=2

# --- Rate limiting (per instance, requests per minute) ---
RATE_LIMIT_RPM=35

# --- LaTeX compiler (pdflatex, xelatex, or lualatex) ---
LATEX_COMPILER=pdflatex
LATEX_MAX_RETRIES=3

# --- Lean 4 formal verifier ---
# Install: curl https://elan.lean-lang.org/elan-init.sh -sSf | sh
LEAN_TIMEOUT=60
